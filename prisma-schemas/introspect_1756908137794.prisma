generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model database_connections {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  name       String    @db.VarChar
  host       String    @db.VarChar
  port       String    @default("5432") @db.VarChar
  database   String    @db.VarChar
  username   String    @db.VarChar
  password   String    @db.VarChar
  ssl_mode   String?   @default("prefer") @db.VarChar
  is_active  Boolean?  @default(true)
  user_id    String    @db.VarChar
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "database_connections_user_id_users_id_fk")
  schemas    schemas[]
}

model schemas {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  name                   String               @db.VarChar
  description            String?
  prisma_content         String
  is_active              Boolean?             @default(true)
  created_at             DateTime?            @default(now()) @db.Timestamp(6)
  updated_at             DateTime?            @default(now()) @db.Timestamp(6)
  database_connection_id String               @db.VarChar
  last_synced_at         DateTime?            @db.Timestamp(6)
  schema_hash            String?              @db.VarChar
  database_connections   database_connections @relation(fields: [database_connection_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "schemas_database_connection_id_database_connections_id_fk")
  sync_logs              sync_logs[]

  @@index([name, database_connection_id], map: "unique_schema_per_db")
}

model sessions {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

model sync_logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  schema_id  String    @db.VarChar
  status     String    @db.VarChar
  message    String?
  output     String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  schemas    schemas   @relation(fields: [schema_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sync_logs_schema_id_schemas_id_fk")
}

model users {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar
  email                String?                @unique(map: "users_email_unique") @db.VarChar
  first_name           String?                @db.VarChar
  last_name            String?                @db.VarChar
  profile_image_url    String?                @db.VarChar
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  database_connections database_connections[]
}
